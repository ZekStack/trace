{
  "name": "Trace",
  "version": "0.3.0",
  "description": "Logging and diagnostics library for ESP32 devices with Strata-backed bounded buffers and task-side flushing.",
  "keywords": [
    "esp32",
    "logging",
    "diagnostics",
    "arduinojson",
    "freertos",
    "strata"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ZekStack/trace.git"
  },
  "authors": [
    {
      "name": "zekageri",
      "maintainer": true
    }
  ],
  "license": "MIT",
  "frameworks": "arduino",
  "platforms": "espressif32",
  "dependencies": {
    "bblanchon/ArduinoJson": ">=7.0.0",
    "Strata": "https://github.com/ZekStack/strata.git#v0.1.2"
  },
  "build": {
    "srcDir": "src",
    "includeDir": "src",
    "flags": [
      "-std=gnu++20"
    ]
  }
}
